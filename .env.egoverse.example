# Copy to .env.egoverse and obtain these values from the EgoVerse maintainers.
# Never copy credentials embedded in source files or commit real values here.
AWS_ACCESS_KEY_ID=replace-with-least-privileged-aws-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret
AWS_DEFAULT_REGION=us-east-2
SECRETS_ARN=replace-with-readonly-database-secret-arn

R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-readonly-r2-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret

# Optional. The runner uses logger=debug unless logger=wandb is explicitly passed.
WANDB_API_KEY=

